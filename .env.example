# =============================================================================
# .env.example — 로드레일 (RoadRail) (값은 비워 둔 채 커밋)
#   cp .env.example .env 후 값을 채우세요. make up 은 .env 가 없으면 만들어 주고
#   ADMIN_TOKEN 이 비어 있으면 무작위 값으로 채웁니다.
#   값 뒤에 줄 끝 주석을 달지 마세요 (docker compose 가 값으로 읽습니다).
# =============================================================================

# ---- 외부 API 키 (서버에서만 사용) ----
# 고속도로 공공데이터 포털(data.ex.co.kr) Open API 인증키 (요청 파라미터 key)
EX_API_KEY=
# 공공데이터포털 일반 인증키 (Decoding 키) — 코레일 열차운행정보 · 기상청 단기예보 · 에어코리아 대기오염정보 · 국토교통부(TAGO) 지하철정보
DATA_GO_KR_KEY=
# 카카오 REST API 키 — 로컬 키워드 검색(역 좌표 보정) · (선택) 카카오모빌리티 미래 운행 정보 길찾기
KAKAO_REST_API_KEY=

# ---- 브라우저에 노출되는 유일한 키 ----
# 카카오 JavaScript 키 (플랫폼 Web 도메인에 http://localhost:3300 등록, 카카오맵 사용 ON)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ---- 관리 API 보호 토큰 (X-Admin-Token) — make up 이 비어 있으면 자동 생성 ----
ADMIN_TOKEN=

# ---- 공급자별 일일 호출 예산 (NFR-02) ----
QUOTA_EX=20000
QUOTA_KORAIL=9000
QUOTA_KMA=9000
QUOTA_AIRKOREA=450
QUOTA_KAKAO=5000
QUOTA_KAKAO_LOCAL=50000
QUOTA_TAGO=9000
QUOTA_OSM=60
QUOTA_TAGO_TRAIN=9000

# ---- 판단·정시성 파라미터 (R-DEC-01, P-v1) ----
ON_TIME_THRESHOLD_MIN=5
DECISION_SIMILAR_MIN=10
DECISION_POP_WARN=60
DEFAULT_ACCESS_MIN=20
FORECAST_TAU_MIN=90

# ---- 스케줄러 ----
# false 면 주기 작업을 등록하지 않고 관리 API(수동 실행)만 받습니다.
SCHEDULER_ENABLED=true
# 철도 일 배치의 향후 운행계획 수집 일수
RAIL_PLAN_DAYS_AHEAD=30
